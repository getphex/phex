{
    "name": "getphex/phex",
    "description": "The application skeleton for the Phex framework.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "getphex/framework": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\Generated\\": "var/generated/",
            "App\\": "app/"
        }
    },
    "scripts": {
        "serve": "@php -S 127.0.0.1:3130 -t public public/index.php",
        "serve:native": "var/build/start",
        "build": "phex build config/build.php",
        "build:native": "phex compile config/build.php"
    }
}
